# Resend API Configuration for OTP Password Reset
# Get your API key at: https://resend.com/api-keys
# 
# Option A - Demo Mode:
# Leave the placeholders as-is. OTP codes will be displayed on screen and logged in console.
#
# Option B - Real Emails (Resend Free Sandbox):
# VITE_RESEND_API_KEY=re_your_api_key
# VITE_EMAIL_FROM=FoodShare <onboarding@resend.dev>  (Sends only to your Resend account email)
#
# Option C - Real Emails (Custom Domain):
# VITE_RESEND_API_KEY=re_your_api_key
# VITE_EMAIL_FROM=FoodShare <noreply@yourdomain.com>

VITE_RESEND_API_KEY=your_resend_api_key_here
VITE_EMAIL_FROM=FoodShare <onboarding@resend.dev>
